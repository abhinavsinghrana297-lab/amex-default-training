# Data never goes into git (too big, and Kaggle's licence doesn't allow redistribution)
data/
*.csv
*.parquet
!tests/fixtures/*.parquet

# Model files are published as GitHub Release assets instead
models/*
!models/.gitkeep

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/

# Notebooks
.ipynb_checkpoints/

# OS / editor
.DS_Store
.vscode/
.idea/
